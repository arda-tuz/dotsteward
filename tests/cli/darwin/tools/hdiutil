#!/usr/bin/env bash
# hdiutil double of the darwin platform tests (hdiutil exists only on
# macOS). A disk image is what make_dmg writes: a tar of the volume
# followed by a 512-byte UDIF trailer starting with "koly".
#   hdiutil attach [-nobrowse] [-readonly] [-noautoopen] [-quiet]
#                  -mountpoint DIR IMAGE
#                  extracts the volume into DIR (created when missing)
#   hdiutil detach [-force] [-quiet] DIR
#                  empties DIR and forgets the mount
# Mounted directories are listed in the state file "mounted". State value
# "fail" (see darwin_tool_set): "attach" makes attach fail, "detach" makes
# detach fail unless -force is given, "detach-all" makes every detach fail.
set -euo pipefail
# shellcheck source=tests/lib/harness.sh
source "$(dirname "$(readlink -f "$0")")/../../../lib/harness.sh"
ds_stub_begin --no-routes hdiutil "$@"

fail=$(ds_stub_value fail '')
mounted=$DS_STUB_DIR/mounted
mkdir -p "$DS_STUB_DIR"
touch "$mounted"
verb=${1:-}
shift || true
force=0 mountpoint='' operands=()
while (($#)); do
  case $1 in
    -nobrowse | -readonly | -noautoopen | -quiet | -noverify) shift ;;
    -force)
      force=1
      shift
      ;;
    -mountpoint)
      (($# >= 2)) || exit 2
      mountpoint=$2
      shift 2
      ;;
    -*)
      printf 'hdiutil: %s: unknown option %s\n' "$verb" "$1" >&2
      exit 2
      ;;
    *)
      operands+=("$1")
      shift
      ;;
  esac
done

case $verb in
  attach)
    [[ -n $mountpoint && ${#operands[@]} == 1 ]] || {
      printf 'hdiutil double: attach needs -mountpoint DIR IMAGE\n' >&2
      exit 2
    }
    image=${operands[0]}
    if [[ $fail == attach || ! -f $image || $(tail -c 512 "$image" | head -c 4) != koly ]]; then
      printf 'hdiutil: attach failed - image not recognized\n' >&2
      exit 1
    fi
    mkdir -p "$mountpoint"
    size=$(stat -c %s -- "$image")
    head -c $((size - 512)) "$image" | tar -x -C "$mountpoint"
    printf '%s\n' "$mountpoint" >>"$mounted"
    printf '/dev/disk4          \tGUID_partition_scheme          \t\n'
    printf '/dev/disk4s1        \tApple_HFS                      \t%s\n' "$mountpoint"
    ;;
  detach)
    [[ ${#operands[@]} == 1 ]] || exit 2
    target=${operands[0]}
    if ! grep -qxF -- "$target" "$mounted"; then
      printf 'hdiutil: detach failed - No such file or directory\n' >&2
      exit 1
    fi
    if [[ $fail == detach-all || ($fail == detach && $force == 0) ]]; then
      printf 'hdiutil: couldn'\''t unmount "disk4" - Resource busy\n' >&2
      exit 16
    fi
    find "$target" -mindepth 1 -delete
    grep -vxF -- "$target" "$mounted" >"$mounted.new" || true
    mv -- "$mounted.new" "$mounted"
    printf '"disk4" ejected.\n'
    ;;
  *)
    printf 'hdiutil double: unsupported verb: %s\n' "$verb" >&2
    exit 2
    ;;
esac
