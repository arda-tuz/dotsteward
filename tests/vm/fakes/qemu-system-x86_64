#!/usr/bin/env bash
# Fake qemu-system-x86_64 for the VM harness tests: never emulates anything.
# Records its arguments in DS_CALL_LOG. With -daemonize it behaves like a
# started VM: it writes the serial console file (-serial file:PATH), starts
# a long sleep whose command line carries "fake-qemu" and the pid file path,
# writes that pid to the -pidfile and exits 0.
# Behaviour files in DS_STUB_STATE/qemu-system-x86_64/:
#   fail     QEMU refuses to start: prints the file's text, exits 1
#   crash    the VM dies right after the start (the pid file names a
#            process that has already exited)
set -euo pipefail
# shellcheck source=tests/lib/harness.sh
source "$(dirname "$(readlink -f "$0")")/../../lib/harness.sh"
ds_stub_begin --no-routes qemu-system-x86_64 "$@"

state=$DS_STUB_STATE/qemu-system-x86_64
pidfile="" console="" daemonize=0
while (($#)); do
  case $1 in
    -pidfile)
      pidfile=$2
      shift
      ;;
    -serial)
      [[ $2 == file:* ]] && console=${2#file:}
      shift
      ;;
    -daemonize) daemonize=1 ;;
  esac
  shift
done

if [[ -f $state/fail ]]; then
  cat -- "$state/fail" >&2
  exit 1
fi
((daemonize)) || exit 0
[[ -n $pidfile ]] || {
  echo 'fake qemu: -daemonize without -pidfile' >&2
  exit 1
}
if [[ -n $console ]]; then
  printf 'fake console: firmware\nfake console: cloud-init started\n' >"$console"
fi
if [[ -f $state/crash ]]; then
  sh -c 'exit 0' &
  pid=$!
  wait "$pid" || true
  printf '%s\n' "$pid" >"$pidfile"
  exit 0
fi
# The subshell execs sleep, so $! is the sleep process itself.
(exec -a "fake-qemu -pidfile $pidfile" sleep 300) </dev/null >/dev/null 2>&1 &
printf '%s\n' "$!" >"$pidfile"
exit 0
