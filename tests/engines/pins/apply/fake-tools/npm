#!/usr/bin/env python3
"""A fake npm: `npm --prefix DIR install --package-lock-only ...` writes a
lockfileVersion 3 package-lock.json from package.json, with integrities that
follow the versions; `npm --prefix DIR audit --json` answers as npm does, with the next
number of FAKE_NIX_STATE/audit-counts as its findings (none when the file is used up), a word
instead of a number gives no document."""

import base64
import hashlib
import json
import os
import pathlib
import sys

STATE = pathlib.Path(os.environ["FAKE_NIX_STATE"])


def node(name, version):
    digest = base64.b64encode(hashlib.sha512(f"{name}@{version}".encode()).digest()).decode()
    return {
        "version": version,
        "resolved": f"https://registry.example.invalid/{name}/-/{name}-{version}.tgz",
        "integrity": f"sha512-{digest}",
        "engines": {"node": ">=20"},
    }


def main():
    args = sys.argv[1:]
    directory = pathlib.Path(args[args.index("--prefix") + 1])
    if "audit" in args:
        counts = STATE / "audit-counts"
        words = counts.read_text().split() if counts.exists() else []
        answer = words[0] if words else "0"
        if words:
            counts.write_text(" ".join(words[1:]))
        if not answer.isdigit():
            sys.exit("npm error audit endpoint returned an error")
        print(json.dumps({"metadata": {"vulnerabilities": {"total": int(answer)}}}))
        sys.exit(1 if int(answer) else 0)
    package = json.loads((directory / "package.json").read_text())
    dependencies = package["dependencies"]
    packages = {"": {"name": package["name"], "dependencies": dependencies}}
    for name, version in dependencies.items():
        packages[f"node_modules/{name}"] = node(name, version)
    for scope, value in package.get("overrides", {}).items():
        if isinstance(value, dict):
            for name, version in value.items():
                packages[f"node_modules/{scope}/node_modules/{name}"] = node(name, version)
        else:
            packages[f"node_modules/{scope}"] = node(scope, value)
    lock = {"name": package["name"], "lockfileVersion": 3, "requires": True, "packages": packages}
    (directory / "package-lock.json").write_text(json.dumps(lock, indent=2) + "\n")


main()
