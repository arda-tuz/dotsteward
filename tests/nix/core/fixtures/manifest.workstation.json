{
  "schema_version": 1,
  "system": "x86_64-linux",
  "platform": "linux",
  "components": [
    {
      "name": "shell",
      "source": "catalog",
      "method": "nix",
      "profiles": null,
      "platforms": ["linux", "darwin"],
      "modes": { "workstation": "adopt", "fresh": "fresh" },
      "supported_methods": { "linux": [], "darwin": [] },
      "install": { "packages": [] },
      "options": {}
    },
    {
      "name": "example-term",
      "source": "instance",
      "method": "official-binary",
      "profiles": ["workstation"],
      "platforms": ["linux", "darwin"],
      "modes": { "workstation": "adopt" },
      "supported_methods": { "linux": ["official-binary", "nix"], "darwin": ["official-binary"] },
      "install": {
        "pin": "agent_tools.example-term",
        "asset": {
          "linux": "example-term-{version}-x86_64-linux.tar.gz",
          "darwin": "example-term-{version}-aarch64-darwin.tar.gz"
        },
        "member": "example-term",
        "dest": "~/.local/bin/example-term",
        "versionArgv": ["--version"],
        "versionRegex": "example-term ([0-9.]+)",
        "policy": "at-least",
        "verify": "sha256"
      },
      "options": { "flag": true }
    },
    {
      "name": "example-app",
      "source": "instance",
      "method": "nix",
      "profiles": null,
      "platforms": ["linux", "darwin"],
      "modes": { "workstation": "adopt", "fresh": "fresh" },
      "supported_methods": { "linux": ["nix"], "darwin": ["nix"] },
      "install": { "packages": ["example-app"] },
      "options": {}
    }
  ],
  "settings_targets": {
    "alpha": {
      "component": "example-app",
      "path": "~/.config/example-app/alpha.json",
      "format": "json",
      "create_if_missing": true,
      "create_mode": "0644",
      "backup": true,
      "reload": null
    },
    "beta": {
      "component": "example-term",
      "path": "~/.config/example-term/beta.toml",
      "format": "toml",
      "create_if_missing": true,
      "create_mode": "0600",
      "backup": true,
      "reload": "example-term-reload"
    },
    "delta": {
      "component": "example-term",
      "path": "~/.config/example-term/delta.jsonc",
      "format": "jsonc",
      "create_if_missing": false,
      "create_mode": "0644",
      "backup": false,
      "reload": {
        "command": ["example-term", "reload", "{home}"],
        "timeout": 5,
        "env": {},
        "unset_env": [],
        "require_command": null,
        "on_success": "silent",
        "on_failure": "warn"
      }
    }
  },
  "reload_hooks": {
    "example-term-reload": {
      "component": "example-term",
      "command": ["example-term", "server", "reload-config"],
      "timeout": 15,
      "env": { "HOME": "{home}" },
      "unset_env": ["EXAMPLE_TERM_SOCKET"],
      "require_command": "example-term",
      "on_success": "log",
      "on_failure": "silent"
    }
  },
  "probes": [
    {
      "component": "example-term",
      "command": "example-term",
      "kind": "version",
      "argv": ["--version"],
      "env": {},
      "extract": "prefix:example-term ",
      "expected": "versions:agent_tools.example-term.version",
      "needles": [],
      "profiles": null
    },
    {
      "component": "example-app",
      "command": "example-app",
      "kind": "presence",
      "argv": ["--version"],
      "env": {},
      "extract": "first-line",
      "expected": null,
      "needles": [],
      "profiles": null
    }
  ],
  "checks": {
    "commands": [
      { "component": "core", "command": "jq" },
      { "component": "core", "command": "local-maintained-files" },
      { "component": "example-term", "command": "example-term" },
      { "component": "example-term", "command": "jq" },
      { "component": "example-app", "command": "example-app" }
    ],
    "e2e": [
      { "component": "example-term", "name": "example-term-config", "phase": "late", "profiles": ["workstation"] }
    ],
    "agents": [
      { "component": "example-term", "name": "example-term-agents", "phase": "main", "profiles": null }
    ],
    "floors": [
      {
        "component": "example-term",
        "command": "example-term",
        "argv": ["--version"],
        "minimum": "agent_tools.example-term.minimum",
        "compare": "semver"
      }
    ]
  },
  "hooks": {
    "pre_activate": [
      { "component": "example-term", "name": "example-term-pre", "phase": "main", "profiles": null }
    ],
    "system_install": [],
    "post_install": [],
    "forbid": [],
    "agents_install": [],
    "agents_migrate": [],
    "agents_post": [],
    "desktop_apply": []
  },
  "backup_paths": [
    "~/.config/nix/nix.conf",
    "~/.agents/skills",
    "~/.config/example-term/beta.toml",
    "/etc/shells",
    "~/.config/example-app",
    "~/.example-app/AGENTS.md"
  ],
  "snapshots": [
    { "component": "example-term", "name": "example-term-state", "argv": ["example-term", "dump"], "require_command": null }
  ],
  "prerequisites": { "apt": ["example-term-deps"] },
  "managed_links": ["~/.config/nix/nix.conf", "~/.example-term/RULES.md", "~/.example-app/AGENTS.md"],
  "force_linked_restore": [
    { "component": "example-term", "path": "~/.example-term/RULES.md", "mode": "0664" }
  ],
  "adopt_paths": ["~/.config/example-term/state"],
  "preflight_detectors": {
    "example_detector": { "component": "example-term", "argv": ["example-term", "detect"], "match_line": "yes" }
  },
  "skill_layout": {
    "legacy_roots": ["~/.example-term/skills"],
    "link_roots": {
      "~/.example-term/linked": { "component": "example-term", "target_prefix": "../../.agents/skills/" }
    },
    "excluded_subtrees": [".system"]
  },
  "agent_rules": {
    "targets": [
      { "component": "example-term", "path": ".example-term/RULES.md", "force": true },
      { "component": "example-app", "path": ".example-app/AGENTS.md", "force": false }
    ]
  },
  "update_allowlist": ["components/example-term/[^/]+"],
  "pins": {
    "rules": [
      {
        "component": "example-term",
        "kind": "derive",
        "to": "nix_packages.example-term.expected",
        "from": "agent_tools.example-term.version"
      }
    ],
    "latest": [
      {
        "component": "example-term",
        "id": "agent_tools.example-term",
        "adapter": "github-release",
        "repo": "example/example-term"
      }
    ],
    "resolved_versions": { "example-term": "1.2.3", "example-app": "1.0.0" },
    "flake_inputs": ["example-term"]
  },
  "skills": {
    "hm_root": ".codex/skills",
    "framework": ["dotsteward-maintain", "dotsteward-update"],
    "home_managed": ["example-skill"]
  },
  "files": {},
  "login_shell": "$HOME/.nix-profile/bin/zsh"
}
