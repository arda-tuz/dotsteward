#!/usr/bin/env bash
# systemctl stub over the unit files below the fixture root
# (DS_SYSTEM_ROOT/etc/systemd/system). Like on a real machine, systemd runs
# when DS_SYSTEM_ROOT/run/systemd/system exists; without it only what works
# offline does (enable and disable without --now, is-enabled).
#   daemon-reload             needs root rights (see the sudo stub) and a
#                             running systemd; succeeds
#   enable [--now] UNIT...    needs root rights and the unit file; links the
#                             unit into <target>.wants of each WantedBy= of
#                             its [Install] section; --now also starts it
#   disable [--now] UNIT...   needs root rights; removes those links; --now
#                             also stops it
#   start|stop UNIT...        needs root rights and a running systemd; the
#                             unit file must exist for start
#   is-enabled UNIT           prints enabled or disabled; exit 0 or 1
#   is-active UNIT            prints active or inactive; exit 0 or 3
# A started unit is remembered in the state of the stub.
# --user talks to the user manager of HOME instead: its units are
# $HOME/.config/systemd/user, no root rights are needed, and it is reachable
# only when the state value "user-manager" is "running" (else, as in a
# container: "Failed to connect to bus", exit 1). As systemd does, it loads a
# unit file on demand: a unit whose file is there is loaded, started or not.
#   daemon-reload             succeeds
#   start UNIT...             needs the unit file; active from then on
#   stop UNIT...              inactive, but it was active once
#   is-active UNIT            active, failed (the state value
#                             "failed-UNIT" holds its Result) or inactive
#   show [-p PROPERTY]... [--value] UNIT   LoadState (loaded or not-found),
#                             ActiveState, Result (success unless failed)
#                             and ActiveEnterTimestampMonotonic (0 for a unit
#                             that was never active)
set -euo pipefail
# shellcheck source=tests/lib/harness.sh
source "$(dirname "$(readlink -f "$0")")/../harness.sh"
ds_stub_begin systemctl "$@"

units_dir=$DS_SYSTEM_ROOT/etc/systemd/system
active_dir=$DS_STUB_DIR/active

now=0
user=0
words=()
for arg in "$@"; do
  case $arg in
    --now) now=1 ;;
    --user) user=1 ;;
    -*) ;;
    *) words+=("$arg") ;;
  esac
done
operation=${words[0]:-}
units=("${words[@]:1}")

if ((user)); then
  if [[ $(ds_stub_value user-manager) != running ]]; then
    printf 'Failed to connect to bus: No medium found\n' >&2
    exit 1
  fi
  units_dir=$HOME/.config/systemd/user
  active_dir=$DS_STUB_DIR/user-active
  entered_dir=$DS_STUB_DIR/user-entered
  mkdir -p "$active_dir" "$entered_dir"
  # user_property NAME UNIT: one property as systemctl show prints it.
  user_property() {
    local failed
    failed=$(ds_stub_value "failed-$2")
    case $1 in
      LoadState) if [[ -f $units_dir/$2 ]]; then printf 'loaded'; else printf 'not-found'; fi ;;
      ActiveState)
        if [[ -n $failed ]]; then
          printf 'failed'
        elif [[ -f $active_dir/$2 ]]; then
          printf 'active'
        else
          printf 'inactive'
        fi
        ;;
      Result) printf '%s' "${failed:-success}" ;;
      ActiveEnterTimestampMonotonic) if [[ -f $entered_dir/$2 ]]; then printf '4242000'; else printf '0'; fi ;;
      *) printf '' ;;
    esac
  }
  case $operation in
    daemon-reload) exit 0 ;;
    start)
      for unit in "${units[@]}"; do
        [[ -f $units_dir/$unit ]] || {
          printf 'Failed to start %s: Unit %s not found.\n' "$unit" "$unit" >&2
          exit 5
        }
        : >"$active_dir/$unit"
        : >"$entered_dir/$unit"
      done
      exit 0
      ;;
    stop)
      for unit in "${units[@]}"; do
        rm -f -- "$active_dir/$unit"
      done
      exit 0
      ;;
    is-active)
      state=$(user_property ActiveState "${units[0]}")
      printf '%s\n' "$state"
      [[ $state == active ]] && exit 0
      exit 3
      ;;
    show)
      properties=()
      value=0
      previous=''
      for arg in "$@"; do
        [[ $previous == -p ]] && properties+=("$arg")
        [[ $arg == --value ]] && value=1
        previous=$arg
      done
      unit=${words[-1]}
      for property in "${properties[@]}"; do
        if ((value)); then
          printf '%s\n' "$(user_property "$property" "$unit")"
        else
          printf '%s=%s\n' "$property" "$(user_property "$property" "$unit")"
        fi
      done
      exit 0
      ;;
  esac
fi

require_root() {
  ds_stub_as_root && return 0
  printf 'Failed to %s: Access denied\n' "$1" >&2
  exit 1
}

require_systemd() {
  [[ -d $DS_SYSTEM_ROOT/run/systemd/system ]] && return 0
  printf "System has not been booted with systemd as init system (PID 1). Can't operate.\n" >&2
  printf 'Failed to connect to bus: Host is down\n' >&2
  exit 1
}

require_unit() {
  [[ -f $units_dir/$2 ]] && return 0
  printf 'Failed to %s: Unit file %s does not exist.\n' "$1" "$2" >&2
  exit 1
}

# wanted_by UNIT: the targets of the [Install] section of UNIT, one per line.
wanted_by() {
  sed -n 's/^WantedBy=//p' "$units_dir/$1" | tr ' ' '\n'
}

set_active() {
  mkdir -p "$active_dir"
  : >"$active_dir/$1"
}

case $operation in
  daemon-reload)
    require_root 'reload daemon'
    require_systemd
    ;;
  enable)
    require_root 'enable unit'
    ((!now)) || require_systemd
    for unit in "${units[@]}"; do
      require_unit 'enable unit' "$unit"
      while IFS= read -r target; do
        [[ -n $target ]] || continue
        mkdir -p "$units_dir/$target.wants"
        ln -sfn "$units_dir/$unit" "$units_dir/$target.wants/$unit"
        printf 'Created symlink %s/%s.wants/%s -> %s/%s.\n' "$units_dir" "$target" "$unit" "$units_dir" "$unit"
      done < <(wanted_by "$unit")
      ((!now)) || set_active "$unit"
    done
    ;;
  disable)
    require_root 'disable unit'
    ((!now)) || require_systemd
    for unit in "${units[@]}"; do
      rm -f -- "$units_dir"/*.wants/"$unit"
      ((!now)) || rm -f -- "$active_dir/$unit"
    done
    ;;
  start)
    require_root 'start unit'
    require_systemd
    for unit in "${units[@]}"; do
      require_unit 'start unit' "$unit"
      set_active "$unit"
    done
    ;;
  stop)
    require_root 'stop unit'
    require_systemd
    for unit in "${units[@]}"; do
      rm -f -- "$active_dir/$unit"
    done
    ;;
  is-enabled)
    for link in "$units_dir"/*.wants/"${units[0]}"; do
      if [[ -L $link ]]; then
        printf 'enabled\n'
        exit 0
      fi
    done
    printf 'disabled\n'
    exit 1
    ;;
  is-active)
    if [[ -f $active_dir/${units[0]} ]]; then
      printf 'active\n'
      exit 0
    fi
    printf 'inactive\n'
    exit 3
    ;;
  *)
    printf 'Unknown command verb %s.\n' "$operation" >&2
    exit 1
    ;;
esac
exit 0
