#!/usr/bin/env bash
# chsh stub: changes a login shell in the harness user database.
# `chsh -s|--shell SHELL [USER]` (USER defaults to $USER). Without root
# rights (see the sudo stub) only the own shell can change, and only to a
# shell listed in DOTSTEWARD_ETC_SHELLS; root may set any shell for any
# existing user.
set -euo pipefail
# shellcheck source=tests/lib/harness.sh
source "$(dirname "$(readlink -f "$0")")/../harness.sh"
ds_stub_begin chsh "$@"

usage() {
  printf 'Usage: chsh [options] [LOGIN]\n\nOptions:\n  -s, --shell SHELL  new login shell for the user account\n' >&2
  exit 1
}

shell=""
user=""
while (($#)); do
  case $1 in
    -s | --shell)
      (($# >= 2)) || usage
      shell=$2
      shift 2
      ;;
    --shell=*)
      shell=${1#*=}
      shift
      ;;
    -*) usage ;;
    *)
      [[ -z $user ]] || usage
      user=$1
      shift
      ;;
  esac
done
[[ -n $shell ]] || usage
[[ -n $user ]] || user=$USER

if ! ds_passwd_field "$user" 1 >/dev/null; then
  printf "chsh: user '%s' does not exist\n" "$user" >&2
  exit 1
fi
if ! ds_stub_as_root; then
  if [[ $user != "$USER" ]]; then
    printf "chsh: you may not change the shell for '%s'\n" "$user" >&2
    exit 1
  fi
  if ! grep -Fqx -- "$shell" "${DOTSTEWARD_ETC_SHELLS:?}"; then
    printf 'chsh: %s is an invalid shell\n' "$shell" >&2
    exit 1
  fi
fi
ds_passwd_set "$user" "$shell"
