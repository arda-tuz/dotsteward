#!/usr/bin/env bash
# sudo stub: runs the command as the test user against the fixture root.
# The call is recorded with sudo's own options; those options (-n -E -H -S
# -k -v -b -i -s, -u USER, -g GROUP, -p PROMPT, -C N, -D DIR, -T N,
# --preserve-env[=LIST] and their long forms) are not passed on. NAME=value
# words before the command set its environment, "--" ends the options.
# Every argument (the command included) that is an absolute path below /etc,
# /opt, /srv, /var, /usr/local, /usr/share, /usr/lib, /Applications or
# /Library, alone or after the first "=" of an OPTION=PATH word, is moved
# below DS_SYSTEM_ROOT, so system writes land in the fixture root. The
# command runs with DS_STUB_AS_ROOT=1, which the id, dpkg, apt-get, chsh and
# dscl stubs read as root rights. Ownership cannot be given away by the test
# user, so install runs without its -o/-g options (the call log keeps them)
# and chown and chgrp only check that their files exist. -v or -k without a
# command succeed; a route (for example '*' with --exit 1) simulates a
# refused password.
set -euo pipefail
# shellcheck source=tests/lib/harness.sh
source "$(dirname "$(readlink -f "$0")")/../harness.sh"
ds_stub_begin sudo "$@"

usage() {
  printf '%s\n' "${1:+sudo: $1}" \
    'usage: sudo -h | -K | -k | -V' \
    'usage: sudo -v [-ABkNnS] [-g group] [-h host] [-p prompt] [-u user]' \
    'usage: sudo [-ABbEHkNnPS] [-C num] [-D directory] [-g group] [-h host] [-p prompt] [-R directory] [-T timeout] [-u user] [VAR=value] [-i | -s] [<command>]' |
    sed '/^$/d' >&2
  exit 1
}

credentials_only=0
assignments=()
options_done=0
while (($#)); do
  if ((!options_done)); then
    case $1 in
      --)
        options_done=1
        shift
        continue
        ;;
      -u | -g | -p | -C | -D | -T | -h | -R | --user | --group | --prompt | --close-from | --chdir | --command-timeout | --host | --chroot)
        (($# >= 2)) || usage "option requires an argument -- '${1#-}'"
        shift 2
        continue
        ;;
      --user=* | --group=* | --prompt=* | --close-from=* | --chdir=* | --command-timeout=* | --host=* | --chroot=* | --preserve-env | --preserve-env=*)
        shift
        continue
        ;;
      --non-interactive | --preserve-env* | --set-home | --stdin | --background | --login | --shell | --askpass)
        shift
        continue
        ;;
      --validate | --reset-timestamp | --remove-timestamp)
        credentials_only=1
        shift
        continue
        ;;
      -[!-]*)
        flags=${1#-}
        shift
        while [[ -n $flags ]]; do
          flag=${flags:0:1}
          flags=${flags:1}
          case $flag in
            n | E | H | S | b | i | s | A | B | N | P) ;;
            k | K | v) credentials_only=1 ;;
            u | g | p | C | D | T | R)
              if [[ -z $flags ]]; then
                (($#)) || usage "option requires an argument -- '$flag'"
                shift
              fi
              flags=""
              ;;
            *) usage "invalid option -- '$flag'" ;;
          esac
        done
        continue
        ;;
    esac
  fi
  if [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
    assignments+=("$1")
    shift
    continue
  fi
  break
done

if ((!$#)); then
  ((credentials_only)) && exit 0
  usage
fi

# long_option WORD NAME MIN: true when WORD (without any "=VALUE") is --NAME
# or an abbreviation of it at least MIN characters long, as getopt_long
# accepts unambiguous prefixes.
long_option() {
  local name=${1%%=*}
  [[ $name == --?* && ${#name} -ge $(($3 + 2)) && --$2 == "$name"* ]]
}

# The test user cannot give a file to root, so install loses -o/-g OWNER
# (separate, attached, clustered or long, with or without "=") before it
# runs; every other word, and every word after "--", is kept in order.
if [[ $(basename -- "$1") == install ]]; then
  kept=("$1")
  shift
  while (($#)); do
    word=$1
    shift
    if [[ $word == -- ]]; then
      kept+=(-- "$@")
      break
    elif long_option "$word" owner 1 || long_option "$word" group 1; then
      if [[ $word != *=* ]]; then
        if ((!$#)); then
          kept+=("$word")
          continue
        fi
        shift
      fi
    elif long_option "$word" mode 1 || long_option "$word" suffix 2 ||
      long_option "$word" target-directory 1 || long_option "$word" strip-program 6; then
      kept+=("$word")
      if [[ $word != *=* ]] && (($#)); then
        kept+=("$1")
        shift
      fi
    elif [[ $word == -[!-]* ]]; then
      flags=${word#-}
      rebuilt=-
      value_next=0
      while [[ -n $flags ]]; do
        flag=${flags:0:1}
        flags=${flags:1}
        case $flag in
          o | g)
            if [[ -n $flags ]]; then
              flags=""
            elif (($#)); then
              shift
            else
              rebuilt+=$flag
            fi
            ;;
          m | S | t)
            [[ -n $flags ]] || value_next=1
            rebuilt+=$flag$flags
            flags=""
            ;;
          *) rebuilt+=$flag ;;
        esac
      done
      [[ $rebuilt == - ]] || kept+=("$rebuilt")
      if ((value_next && $#)); then
        kept+=("$1")
        shift
      fi
    else
      kept+=("$word")
    fi
  done
  set -- "${kept[@]}"
fi

system_path() {
  local path=$1 prefix
  if [[ $path == "$DS_TEST_ROOT"/* || $path == "$DS_TEST_ROOT" ]]; then
    printf '%s' "$path"
    return
  fi
  for prefix in /etc /opt /srv /var /usr/local /usr/share /usr/lib /Applications /Library; do
    if [[ $path == "$prefix" || $path == "$prefix"/* ]]; then
      printf '%s' "$DS_SYSTEM_ROOT$path"
      return
    fi
  done
  printf '%s' "$path"
}

command=()
for arg in "$@"; do
  if [[ $arg == /* ]]; then
    command+=("$(system_path "$arg")")
  elif [[ $arg =~ ^(-[^=]*=)(/.*)$ ]]; then
    command+=("${BASH_REMATCH[1]}$(system_path "${BASH_REMATCH[2]}")")
  else
    command+=("$arg")
  fi
done

# chown and chgrp change nothing: they succeed when every file (and the
# --reference file) exists below the fixture root, and otherwise fail with
# the real tools' messages, naming the paths as the caller wrote them.
name=$(basename -- "${command[0]}")
if [[ $name == chown || $name == chgrp ]]; then
  original=("$@")
  operands=()
  reference=0
  options_done=0
  for ((i = 1; i < ${#command[@]}; i++)); do
    word=${command[i]}
    if ((options_done)) || [[ $word != -?* ]]; then
      operands+=("$i")
    elif [[ $word == -- ]]; then
      options_done=1
    elif long_option "$word" reference 3 || long_option "$word" from 1; then
      file=${word#*=}
      shown=${original[i]#*=}
      if [[ $word != *=* ]]; then
        if ((i + 1 == ${#command[@]})); then
          printf "%s: option '%s' requires an argument\n" "$name" "$word" >&2
          exit 1
        fi
        i=$((i + 1))
        file=${command[i]}
        shown=${original[i]}
      fi
      if long_option "$word" reference 3; then
        reference=1
        reference_file=$file
        reference_shown=$shown
      fi
    fi
  done
  if ((reference)); then
    if [[ ! -e $reference_file ]]; then
      printf "%s: failed to get attributes of '%s': No such file or directory\n" "$name" "$reference_shown" >&2
      exit 1
    fi
  elif ((${#operands[@]})); then
    operands=("${operands[@]:1}")
  fi
  if ((!${#operands[@]})); then
    printf "%s: missing operand\nTry '%s --help' for more information.\n" "$name" "$name" >&2
    exit 1
  fi
  status=0
  for i in "${operands[@]}"; do
    if [[ ! -e ${command[i]} && ! -L ${command[i]} ]]; then
      printf "%s: cannot access '%s': No such file or directory\n" "$name" "${original[i]}" >&2
      status=1
    fi
  done
  exit "$status"
fi

exec env DS_STUB_AS_ROOT=1 "${assignments[@]}" "${command[@]}"
