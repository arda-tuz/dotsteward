#!/usr/bin/env bash
# dotsteward commit-msg hook: the message rules of framework commits, checked
# before the commit exists (the pre-push hook and `dotsteward contribute
# check` would refuse the commit only after the work is done).
#
# Install once per clone, with the pre-commit and pre-push hooks next to it
# (dotsteward contribute setup does it as well):
#   git config core.hooksPath .githooks
#
# git runs this hook with the path of the message file. The message is
# refused when its subject is not a conventional commit (TYPE(AREA): text,
# with the types of commit.conventional_types in `dotsteward context
# --json`), when it ends with a trailer block (any `Key: value` lines, as git
# interpret-trailers reads them, such as Co-Authored-By or Signed-off-by), or
# when any line is an attribution line (Co-Authored-By, Signed-off-by,
# Claude-Session, Generated with [Claude Code]). Comment lines and a verbose
# diff below the scissors line do not count. The rules are
# cli/lib/commit-rules.sh next to this directory; without them the commit is
# refused. `dotsteward contribute commit` applies the same rules.
set -Eeuo pipefail

error() {
  printf '[dotsteward] ERROR: commit-msg: %s\n' "$*" >&2
}

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  error "bash 4.4 or newer is required (found $BASH_VERSION); commit refused"
  exit 1
fi

trap 'error "unexpected failure at line $LINENO (exit $?); commit refused"' ERR

if (($# < 1)) || [[ ! -f $1 ]]; then
  error "usage: commit-msg MESSAGE_FILE"
  exit 1
fi

hook_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
rules=$(dirname -- "$hook_dir")/cli/lib/commit-rules.sh
if [[ ! -f $rules ]]; then
  error "the commit rules cli/lib/commit-rules.sh are missing next to the hook; commit refused"
  exit 1
fi
# shellcheck source=cli/lib/commit-rules.sh
source "$rules"

if ! problems=$(commit_rules_message "$1"); then
  while IFS= read -r problem; do
    [[ -z $problem ]] || error "$problem"
  done <<<"$problems"
  error "commit refused: a framework commit has a conventional subject and no trailers; commit with: dotsteward contribute commit -m 'TYPE(AREA): what changed'"
  exit 1
fi
